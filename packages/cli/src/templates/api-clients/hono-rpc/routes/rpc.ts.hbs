import { Hono } from "hono";
import { zValidator } from "@hono/zod-validator";
import { z } from "zod";

const rpcApp = new Hono()
  // Health check endpoint
  .get("/status", async (c) => {
    return c.json({ 
      status: "ok",
      timestamp: new Date().toISOString(),
      service: "api"
    });
  })
  // Example data endpoint
  .get("/data", async (c) => {
    const limit = parseInt(c.req.query("limit") || "10");
    const offset = parseInt(c.req.query("offset") || "0");
    
    // TODO: Replace with actual data fetching logic
    return c.json({ 
      items: [],
      total: 0,
      limit,
      offset
    });
  })
  // Example create endpoint with validation
  .post(
    "/data",
    zValidator(
      "json",
      z.object({
        name: z.string().min(1).max(100),
        description: z.string().optional(),
      })
    ),
    async (c) => {
      const body = c.req.valid("json");
      
      // TODO: Implement actual data creation logic
      return c.json({ 
        id: Date.now().toString(),
        ...body,
        createdAt: new Date().toISOString()
      }, 201);
    }
  )
  // Example update endpoint
  .patch(
    "/data/:id",
    zValidator(
      "json",
      z.object({
        name: z.string().min(1).max(100).optional(),
        description: z.string().optional(),
      })
    ),
    async (c) => {
      const id = c.req.param("id");
      const body = c.req.valid("json");
      
      // TODO: Implement actual update logic
      return c.json({ 
        id,
        ...body,
        updatedAt: new Date().toISOString()
      });
    }
  )
  // Example delete endpoint
  .delete("/data/:id", async (c) => {
    const id = c.req.param("id");
    
    // TODO: Implement actual deletion logic
    return c.json({ success: true, deletedId: id });
  });

// Export the type for client
export type RpcAppType = typeof rpcApp;
export default rpcApp;