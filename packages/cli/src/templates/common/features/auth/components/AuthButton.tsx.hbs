{{#if (eq framework "next")}}'use client';

{{/if}}import React from 'react';

interface AuthButtonProps extends React.ButtonHTMLAttributes<HTMLButtonElement> {
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  isLoading?: boolean;
  children: React.ReactNode;
}

export function AuthButton({
  variant = 'primary',
  size = 'md',
  isLoading = false,
  className = '',
  children,
  disabled,
  ...props
}: AuthButtonProps) {
  const baseClasses = `
    inline-flex items-center justify-center font-medium rounded-lg
    transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2
    disabled:opacity-50 disabled:cursor-not-allowed
  `;

  const sizeClasses = {
    sm: 'px-3 py-2 text-sm',
    md: 'px-4 py-3 text-base',
    lg: 'px-6 py-4 text-lg',
  };

  const variantClasses = {
    primary: `
      bg-primary hover:bg-primary/90
      text-primary-foreground shadow-lg hover:shadow-xl
      focus:ring-primary active:scale-[0.98]
    `,
    secondary: `
      bg-secondary hover:bg-secondary/90
      text-secondary-foreground shadow-lg hover:shadow-xl
      focus:ring-secondary active:scale-[0.98]
    `,
    outline: `
      border-2 border-input hover:border-accent
      bg-transparent hover:bg-accent hover:text-accent-foreground
      text-foreground
      focus:ring-accent active:scale-[0.98]
    `,
    ghost: `
      bg-transparent hover:bg-accent hover:text-accent-foreground
      text-foreground
      focus:ring-accent active:scale-[0.98]
    `,
  };

  const classes = `
    ${baseClasses}
    ${sizeClasses[size]}
    ${variantClasses[variant]}
    ${className}
  `;

  return (
    <button
      className={classes}
      disabled={disabled || isLoading}
      {...props}
    >
      {children}
    </button>
  );
}