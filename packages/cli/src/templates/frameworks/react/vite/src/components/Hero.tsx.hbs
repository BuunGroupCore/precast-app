`;

const BadgeDot = styled.span`
  position: relative;
  display: flex;
  height: 0.5rem;
  width: 0.5rem;
  margin-right: 0.5rem;
  
  &::before {
    content: '';
    position: absolute;
    inline-size: 100%;
    block-size: 100%;
    border-radius: 9999px;
    background: #a855f7;
    opacity: 0.75;
    animation: ping 1s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  
  &::after {
    content: '';
    position: relative;
    display: inline-flex;
    border-radius: 9999px;
    height: 0.5rem;
    width: 0.5rem;
    background: #9333ea;
  }
  
  @keyframes ping {
    75%, 100% {
      transform: scale(2);
      opacity: 0;
    }
  }
`;

const Title = styled.h1`
